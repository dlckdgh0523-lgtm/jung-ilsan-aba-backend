// 정지은 일산 ABA — Prisma schema
// Field names follow the ACTUAL frontend contract (data.js / *.jsx), not API_SPEC.md,
// per the reconciliation rules in memory.md §5. Columns map to snake_case (API_SPEC §16).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ───────────────────────────────────────────────────────────────────
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin")
  // Bumped on logout to invalidate previously issued JWTs (stateless revocation).
  tokenVersion Int      @default(0) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

// ── Singletons ───────────────────────────────────────────────────────────────
model SiteSetting {
  id        String   @id @default("singleton")
  brand     Json
  sections  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model NavItem {
  id        String   @id // semantic id: "about", "programs", "contact", ...
  label     String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("nav_items")
}

model About {
  id        String   @id @default("singleton")
  eyebrow   String?
  title     String?
  lead      Json     @default("[]")
  body      Json     @default("[]")
  values    Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("about")
}

model Director {
  id             String   @id @default("singleton")
  name           String?
  role           String?
  sub            String?
  photo          String?
  certifications Json     @default("[]")
  education      Json     @default("[]")
  // Stored once; API exposes as BOTH `organizations` and `societies` (see memory.md §5.4).
  organizations  Json     @default("[]")
  career         Json     @default("[]")
  awards         Json     @default("[]")
  papers         Json     @default("[]")
  training       Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("director")
}

model CenterInfo {
  id                 String   @id @default("singleton")
  eyebrow            String?
  title              String?
  sub                String?
  highlights         Json     @default("[]")
  earlyClasses       Json     @default("[]") @map("early_classes")
  individualSessions Json     @default("[]") @map("individual_sessions")
  closingNote        String?  @map("closing_note")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("center_info")
}

// ── Ordered collections ──────────────────────────────────────────────────────
model HeroSlide {
  id          String    @id @default(cuid())
  eyebrow     String?
  title       String
  subtitle    String?
  image       String?
  buttonText  String?   @map("button_text")
  buttonLink  String?   @map("button_link")
  buttonText2 String?   @map("button_text2")
  buttonLink2 String?   @map("button_link2")
  order       Int       @default(0)
  visible     Boolean   @default(true)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt, visible, order])
  @@map("hero_slides")
}

model Program {
  id        String    @id @default(cuid())
  title     String
  ageRange  String?   @map("age_range")
  photo     String?
  desc      String?
  icon      String?
  tone      String? // orange | green | yellow | green-soft (validated in DTO)
  tags      Json      @default("[]")
  meta      String?
  detail    Json? // { intro, sections: [{ heading, body }] }
  order     Int       @default(0)
  visible   Boolean   @default(true)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt, visible, order])
  @@map("programs")
}

model Therapist {
  id             String    @id @default(cuid())
  name           String
  role           String?
  tone           String?
  photo          String?
  summary        String?
  education      Json      @default("[]")
  career         Json      @default("[]")
  certifications Json      @default("[]")
  teaching       Json      @default("[]")
  papers         Json      @default("[]")
  completion     String?
  order          Int       @default(0)
  visible        Boolean   @default(true)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt, visible, order])
  @@map("therapists")
}

model Notice {
  id        String    @id @default(cuid())
  title     String
  body      String?
  date      String? // free-form display string e.g. "2026.05.18" (frontend uses dots)
  image       String?
  attachments Json      @default("[]")
  pinned    Boolean   @default(false)
  views     Int       @default(0)
  order     Int       @default(0)
  visible   Boolean   @default(true)
  // Naver blog sync provenance — set only on notices imported from the blog.
  // sourceUrl doubles as the dedupe key: a notice (even soft-deleted) with the
  // same sourceUrl is never re-imported.
  sourceUrl String?   @unique @map("source_url")
  sourceId  String?   @map("source_id") // Naver logNo
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt, visible, pinned, order])
  @@map("notices")
}

// One row per blog-sync execution (cron or manual) — operational observability.
// Only the most recent runs are retained; see BlogSyncService.pruneRuns.
model BlogSyncRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @map("started_at")
  finishedAt DateTime? @map("finished_at")
  status     String // running | ok | error
  fetched    Int       @default(0) // RSS items seen
  notified   Int       @default(0) // review alimtalks delivered (≥1 recipient)
  created    Int       @default(0) // notices created this run
  skipped    Int       @default(0) // cutoff / category / duplicate skips
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([startedAt])
  @@map("blog_sync_runs")
}

// One review link per synced article: the director opens it from the alimtalk,
// previews the draft, and publishes/holds — no login, no admin page.
// Only the SHA-256 hash of the link token is stored; the token itself lives
// nowhere but the sent message.
model ArticleReview {
  id                 String    @id @default(cuid())
  articleId          String    @unique @map("article_id")
  article            Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tokenHash          String    @unique @map("token_hash")
  summary            String? // LLM 1-2 sentence summary shown in the alimtalk
  expiresAt          DateTime  @map("expires_at")
  decidedAt          DateTime? @map("decided_at")
  decision           String? // publish | hold
  decidedVia         String?   @map("decided_via") // kakao-link | admin
  notifiedAt         DateTime? @map("notified_at")
  notifyError        String?   @map("notify_error")
  providerMessageIds Json      @default("[]") @map("provider_message_ids") // [{ to, id, status }]
  createdAt          DateTime  @default(now()) @map("created_at")

  @@map("article_reviews")
}

model GalleryItem {
  id        String    @id @default(cuid())
  src       String?
  title     String? // caption
  body      String? // longer description shown in the lightbox
  span      Int       @default(1) // 1 | 2 (grid column span)
  tags      Json      @default("[]")
  order     Int       @default(0)
  visible   Boolean   @default(true)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt, visible, order])
  @@map("gallery_items")
}

model Popup {
  id             String    @id @default(cuid())
  title          String
  content        String?
  imageUrl       String?   @map("image_url")
  linkUrl        String?   @map("link_url")
  // Stored as date-only "YYYY-MM-DD" strings: the frontend concatenates "T00:00:00".
  startAt        String    @map("start_at")
  endAt          String    @map("end_at")
  isActive       Boolean   @default(true) @map("is_active")
  allowHideToday Boolean   @default(true) @map("allow_hide_today")
  order          Int       @default(0)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt, isActive])
  @@map("popups")
}

model Consultation {
  id             String    @id @default(cuid())
  parent         String
  phone          String
  childAge       String?   @map("child_age") // frontend `age` (free string, e.g. "만 4세")
  childDiagnosis String?   @map("child_diagnosis")
  email          String?
  topic          String? // program id or title text (frontend sends title)
  preferred      Json      @default("[]")
  message        String? // frontend `note`
  privacyConsent Boolean   @default(false) @map("privacy_consent")
  status         String    @default("new") // new | contacted | done
  isRead         Boolean   @default(false) @map("is_read")
  ip             String?
  idempotencyKey String?   @unique @map("idempotency_key") // dedup repeat POSTs (double-click / retry)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt, createdAt])
  @@index([status])
  @@index([isRead])
  @@map("consultations")
}

// ── Content platform (blog / tags / FAQ) — see GEO·SEO spec ────────────────
model ArticleCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  order       Int       @default(0)
  visible     Boolean   @default(true)
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  articles    Article[]

  @@index([deletedAt, visible, order])
  @@map("article_categories")
}

model Tag {
  id             String       @id @default(cuid())
  name           String       @unique
  slug           String       @unique
  description    String?
  seoTitle       String?      @map("seo_title")
  seoDescription String?      @map("seo_description")
  // LOCATION | SERVICE | CONDITION | AUDIENCE | TOPIC (validated in DTO)
  tagType        String       @default("TOPIC") @map("tag_type")
  // Admin override: force-include this tag page in sitemap/indexing even with <3 posts.
  seoIndexed     Boolean      @default(false) @map("seo_indexed")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  articles       ArticleTag[]

  @@map("tags")
}

model Article {
  id                 String           @id @default(cuid())
  title              String
  slug               String           @unique
  excerpt            String?
  content            String? // rich HTML from the admin editor (sanitized on render)
  thumbnail          String?
  categoryId         String?          @map("category_id")
  category           ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // SEO
  seoTitle           String?          @map("seo_title")
  seoDescription     String?          @map("seo_description")
  canonicalUrl       String?          @map("canonical_url")
  // GEO — links the article to the institution's context
  targetAudience     String?          @map("target_audience")
  relatedProgram     String?          @map("related_program") // Program.id
  relatedLocation    String?          @map("related_location")
  faqItems           Json             @default("[]") @map("faq_items") // [{ q, a }]
  structuredDataType String?          @map("structured_data_type") // Article (default) | FAQPage
  isFeatured         Boolean          @default(false) @map("is_featured")
  // Publishing
  status             String           @default("draft") // draft | published
  publishedAt        DateTime?        @map("published_at")
  // Naver blog sync provenance — set only on articles imported from the blog.
  // sourceUrl doubles as the dedupe key: an article (even soft-deleted) with
  // the same sourceUrl is never re-imported.
  sourceUrl          String?          @unique @map("source_url")
  sourceId           String?          @map("source_id") // Naver logNo
  // Original blog title (title holds the LLM-cleaned one; review page can restore this).
  sourceTitle        String?          @map("source_title")
  syncedAt           DateTime?        @map("synced_at")
  review             ArticleReview?
  views              Int              @default(0)
  order              Int              @default(0)
  visible            Boolean          @default(true)
  deletedAt          DateTime?        @map("deleted_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  tags               ArticleTag[]

  @@index([deletedAt, visible, status, publishedAt])
  @@index([categoryId])
  @@map("articles")
}

model ArticleTag {
  articleId String  @map("article_id")
  tagId     String  @map("tag_id")
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

model FaqItem {
  id        String    @id @default(cuid())
  question  String
  answer    String
  order     Int       @default(0)
  visible   Boolean   @default(true)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt, visible, order])
  @@map("faq_items")
}

// ── Misc ─────────────────────────────────────────────────────────────────────
model PrivacyDoc {
  kind      String   @id // "policy" | "consent"
  version   String
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("privacy_docs")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  session   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([session, createdAt])
  @@map("page_views")
}
