# ──────────────────────────────────────────────────────────────
# 정지은 일산 ABA — 백엔드 환경 변수 예시
# 복사:  cp .env.example .env   (Windows: copy .env.example .env)
# ──────────────────────────────────────────────────────────────

# 런타임
NODE_ENV=development
PORT=4000
API_PREFIX=v1
TZ=Asia/Seoul

# 데이터베이스 (docker-compose 사용 시 host=db)
# 로컬 직접 실행:  postgresql://aba:aba_password@localhost:5432/aba?schema=public
DATABASE_URL=postgresql://aba:aba_password@localhost:5432/aba?schema=public

# docker-compose 의 db 컨테이너 자격증명 (compose 가 사용; 운영에선 강력한 값으로 변경)
POSTGRES_USER=aba
POSTGRES_PASSWORD=aba_password
POSTGRES_DB=aba

# JWT
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_TTL_SECONDS=43200

# 기본 관리자 (최초 시드 시 생성). 반드시 운영용 ID/비밀번호로 설정할 것.
ADMIN_DEFAULT_USERNAME=set-your-admin-id
ADMIN_DEFAULT_PASSWORD=set-a-strong-password

# CORS 허용 오리진 (쉼표 구분). 비우면 개발 모드에서 전체 허용.
CORS_ORIGINS=http://localhost:4000,http://localhost:5173

# 업로드 (로컬 디스크 저장)
UPLOAD_DIR=storage/uploads
UPLOAD_PUBLIC_BASE=/uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_IMAGE_MAX_WIDTH=1600

# 업로드를 S3(호환) 스토리지로: UPLOAD_DRIVER=s3 로 켜기
# UPLOAD_DRIVER=s3
# S3_BUCKET=jungeun-aba-uploads
# S3_REGION=auto                     # AWS면 ap-northeast-2, R2면 auto
# S3_KEY_PREFIX=uploads/
# ── S3 호환 스토리지 (Cloudflare R2 / Backblaze B2 / MinIO / KT Cloud 오브젝트스토리지) ──
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   # AWS S3면 비워두기
# S3_FORCE_PATH_STYLE=true           # 생략 시 S3_ENDPOINT 있으면 자동 true
# S3_PUBLIC_BASE=https://pub-xxxx.r2.dev   # R2 퍼블릭 도메인/커스텀 CDN. 커스텀 엔드포인트 사용 시 필수!
# ── 자격증명: IAM 역할 없는 호스트(Render 등)는 아래 키를 env 로 (SDK가 자동 인식) ──
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# 상담 신청 스팸 방지 (IP당 TTL초 내 LIMIT건)
CONSULTATION_RATE_TTL=60
CONSULTATION_RATE_LIMIT=5

# 방문자 통계: 동시접속 산정 윈도(초)
STATS_CONCURRENT_WINDOW_SECONDS=90

# 정적 프론트 서빙 (개발 편의). 운영은 Nginx가 정적 서빙 권장.
SERVE_STATIC=true
STATIC_ROOT=../aba-design-system

# ── 네이버 블로그 → 공지 반자동 동기화 ──
# 기본 꺼짐. true일 때만 크론이 등록되며, 가져온 글은 항상 비공개(visible=false)로 생성됨.
# 첫 도입 순서는 DEPLOY.md의 "블로그 동기화" 섹션 참고.
BLOG_SYNC_ENABLED=false
NAVER_BLOG_ID=                     # 필수(ENABLED=true일 때). 예: ilsanaba
BLOG_SYNC_CRON=*/30 * * * *
BLOG_SYNC_CATEGORIES=              # 쉼표 구분 카테고리 allowlist. 비우면 전체. 예: 공지,센터소식
BLOG_SYNC_MAX_PER_RUN=5            # 1회 실행당 최대 생성 수
BLOG_SYNC_SINCE=                   # ISO 날짜(예: 2026-09-01). 이 날짜 이전 글은 무시. 비우면 첫 실행 시각 기준
BLOG_SYNC_FETCH_TIMEOUT_MS=15000

# ── 블로그 동기화 2단계: 알림톡 승인 + LLM 제목 정리 (전부 선택, 기본 꺼짐) ──
# 이 API의 공개 주소 (알림톡 승인 링크가 여기를 가리킴)
API_PUBLIC_BASE=https://jungaba-api.onrender.com
# 승인 링크 토큰 해시에 섞는 pepper. 32자 이상 랜덤 (openssl rand -base64 32)
REVIEW_TOKEN_SECRET=
REVIEW_TOKEN_TTL_DAYS=7

# 알림톡 (딜러사: 솔라피 기준. 설정 순서는 DEPLOY.md §13)
ALIMTALK_ENABLED=false
ALIMTALK_PROVIDER=solapi
ALIMTALK_API_KEY=
ALIMTALK_API_SECRET=
ALIMTALK_SENDER_KEY=            # 카카오 발신프로필 키(솔라피 pfId)
ALIMTALK_TEMPLATE_REVIEW=       # 승인 요청 템플릿 코드(심사 통과 후 발급)
ALIMTALK_RECIPIENTS=            # 쉼표 구분, 하이픈 없이. 예: 01012345678
ALIMTALK_FALLBACK_SMS=false     # 알림톡 실패 시 SMS 대체(발신번호 등록 필요). v1은 끔

# LLM 제목/요약 정리 (블로그 원제목의 검색 키워드 나열 제거. 본문은 절대 안 건드림)
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Haiku급 소형 모델. 2026-09 기준 claude-haiku-4-5 ($1/1M input, $5/1M output —
# 글당 1회, 월 몇 건 수준이라 사실상 무료). 최신 ID는 Anthropic 문서 확인.
LLM_MODEL=claude-haiku-4-5
